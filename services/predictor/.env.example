# Supabase (service-role key: predictor writes data, keep this secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override default collection intervals (seconds)
INTERVAL_TOKEN_SECONDS=300
INTERVAL_EQUITY_SECONDS=600
INTERVAL_MACRO_SECONDS=900
INTERVAL_FLOWS_SECONDS=86400

# Binance (현재 코드는 Bybit 공개 API만 쓰고 있어 미사용 — 필요해지면 연결)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 텔레그램 — 알림 기능(예측 급변/관리자 로그) 붙일 때 사용
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# KRX 사이트 로그인 계정 (data.krx.co.kr) — 공매도비율 수집(pykrx)에 필요.
# Open API 인증키와는 다른, 사이트 회원가입 아이디/비밀번호.
KRX_ID=
KRX_PW=
